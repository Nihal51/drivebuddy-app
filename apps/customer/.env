# DriveBuddy app — Firebase project and website addresses.
#
# This file IS committed, on purpose, exactly like the website's .env.production.
# These are PUBLIC IDENTIFIERS: they are compiled into the app, so anyone who
# installs it can read them either way. What protects customers' data is
# firestore.rules in the website repo (Nihal51/very_new).
#
# .env.local (not committed) overrides this file on your own computer, e.g. to
# point a test build at a separate Firebase project.

# Same Firebase project as https://thedrivebuddy.in
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCIGiv764yafx3HsmmbwpQuolKQcm64Ulo
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=drive-buddy-acc4c.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=drive-buddy-acc4c
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=drive-buddy-acc4c.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=56159522240
EXPO_PUBLIC_FIREBASE_APP_ID=1:56159522240:web:d8454bea63494f064dcc25

# Google login. The "Web client ID" from Firebase console → Authentication →
# Sign-in method → Google → Web SDK configuration (ends in
# .apps.googleusercontent.com). Empty = the app hides "Continue with Google"
# and customers book as guests, like on the website without logging in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# The website. Prices and phone numbers come from $SITE_URL/app-config.json.
EXPO_PUBLIC_SITE_URL=https://thedrivebuddy.in
