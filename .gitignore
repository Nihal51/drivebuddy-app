# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native folders are generated by `expo prebuild` / EAS Build from app.config.ts.
# Never edit or commit them: change app.config.ts instead.
/apps/*/ios
/apps/*/android

# Signing keys and store credentials stay with EAS (or a password manager), never in git
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
play-service-account*.json

# Metro
.metro-health-check*

# Tests
coverage/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# OS / editors
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# local env overrides (the committed .env holds only public identifiers)
.env*.local

# typescript
*.tsbuildinfo
