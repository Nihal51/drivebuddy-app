{
  "name": "drivebuddy-mobile",
  "private": true,
  "description": "DriveBuddy mobile apps: the customer app (and, next, the driver app), sharing one backend with thedrivebuddy.in.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "customer": "npm --workspace @drivebuddy/customer run start",
    "customer:web": "npm --workspace @drivebuddy/customer run web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "test-renderer": "1.2.0"
  }
}
